<mxfile host="app.diagrams.net"><diagram id="MailFlow-architecture" name="Logical architecture"><mxGraphModel dx="1280" dy="730" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="620"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="MailFlow · logical architecture" style="text;html=0;fontFamily=Arial;fontSize=32;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="24" width="1184" height="48" /></mxCell><mxCell id="subtitle" value="A sample-inbox application with a Python API, local storage, and external inference." style="text;html=0;fontFamily=Arial;fontSize=20;align=left;fontColor=#61707c;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="72" width="1184" height="35" /></mxCell><mxCell id="ui" value="React interface&#10;Inbox, prompts, chat, drafts&#10;Vite development server" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fillColor=#f7f9fa;strokeColor=#dce2e6;fontColor=#17212b;fontFamily=Arial;fontSize=20;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="160" width="260" height="110" /></mxCell><mxCell id="api" value="FastAPI routes&#10;Emails, processing, agent, drafts&#10;SQLAlchemy data access" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fillColor=#f7f9fa;strokeColor=#dce2e6;fontColor=#17212b;fontFamily=Arial;fontSize=20;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="388" y="160" width="350" height="110" /></mxCell><mxCell id="llm" value="Groq model service&#10;Categorization and extraction&#10;Prompted chat / generation" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fillColor=#f7f9fa;strokeColor=#dce2e6;fontColor=#17212b;fontFamily=Arial;fontSize=20;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="818" y="160" width="410" height="110" /></mxCell><mxCell id="db" value="SQLite database&#10;Seeded emails + prompts&#10;Actions + saved drafts" style="rounded=1;arcSize=5;whiteSpace=wrap;htm