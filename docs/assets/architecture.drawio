1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#80909b;endArrow=block;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" source="seed" target="db" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#80909b;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" source="api" target="ui" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#80909b;endArrow=block;exitX=0.10571428571428572;exitY=0.0;entryX=0.8538461538461538;entryY=0.0;dashed=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="425" y="125" /><mxPoint x="270" y="125" /></Array></mxGeometry></mxCell><mxCell id="note-0" value="Selected email content and prompts go to Groq. This demo has no user authentication or tenant isolation." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#61707c;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="522" width="1184" height="26" /></mxCell><mxCell id="note-1" value="Draft CRUD stores user-reviewed text in SQLite; no outbound email delivery is implemented." style="text;html=0;align=left;fontFamily=Arial;fontSize=18;fontColor=#61707c;" vertex="1" parent="1"><mxGeometry as="geometry" x="48" y="549" width="1184" height="26" /></mxCell></root></mxGraphModel></diagram></mxfile>